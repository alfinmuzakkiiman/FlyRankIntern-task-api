DATABASE_URL=postgres://postgres:dev@db:5432/tasks

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_public_key
PORT=3000
# LLM provider settings
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# LLM reliability and guardrails
LLM_ENABLED=true
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=250

# Optional provider pricing in USD per 1,000 tokens.
# Leave blank when the provider pricing is unknown.
LLM_INPUT_COST_PER_1K_USD=
LLM_OUTPUT_COST_PER_1K_USD=
